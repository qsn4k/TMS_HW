@using lesson_25.Data.Models
@model Reader

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Reader</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            ID
        </dt>
        <dd class = "col-sm-10">
            @Model.Id
        </dd>
        <dt class = "col-sm-2">
            Фамилия
        </dt>
        <dd class = "col-sm-10">
            @Model.SurName
        </dd>
        <dt class = "col-sm-2">
            Имя
        </dt>
        <dd class = "col-sm-10">
            @Model.Name
        </dd>
        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Название</th>
                    <th>Жанр</th>
                    <th>Год выпуска</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Books)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Title</td>
                        <td>@item.Genre</td>
                        <td>@item.Year</td>
                    </tr>
                }
            </tbody>
        </table>
    </dl>
</div>
<div>
    @Html.ActionLink("Edit", "Edit", new { id = Model.Id }) | @Html.ActionLink("Взять книгу", "TakeBook", new { id = Model.Id }) | @Html.ActionLink("Отдать книгу", "GiveBook", new { id = Model.Id })
    <a asp-action="List">Back to List</a>
</div>

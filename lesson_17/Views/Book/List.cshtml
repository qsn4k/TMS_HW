@using lesson_17.Models;
@model List<lesson_17.ModelView.BookModel>
@{
    ViewData["Title"] = "List";
}

<h1>List</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                ID
            </th>
            <th>
                Title
            </th>
            <th>
                IsBorrowed
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IsBorrowed)
            </td>
            <td>
                <th>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>
                                    Фамилия
                                </th>
                                <th>
                                    Имя
                                </th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                                @foreach (var author in item.Authors)
                                {
                                <tr>
                                    <td>@author.SurName</td>
                                    <td>@author.Name</td>
                                </tr>
                                }
                        </tbody>
                    </table>
                </th>
            </td>
            <td>
                    @Html.ActionLink("Редактировать", "Edit", new { id = item.Id }) |
                    @Html.ActionLink("Информация", "Details", new { id = item.Id }) |
                    @Html.ActionLink("Удалить", "Delete", new { id = item.Id })
            </td>
        </tr>
}
    </tbody>
</table>

@model IEnumerable<lesson_17.Models.Author>

@{
    ViewData["Title"] = "List";
}

<h1>List</h1>

<p>
    <a asp-action="Create">Добавить нового автора</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>
                Фамилия
            </th>
            <th>
                Имя
            </th>
            <th>
                Год рождения
            </th>
            <th>
                Страна происхождения
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>@item.Id</td>
            <td>@item.SurName</td>
            <td>@item.Name</td>
            <td>@item.BirthYear</td>
            <td>@item.Country</td>
            <td>
                @Html.ActionLink("Редактировать", "Edit", new { /* id=item.PrimaryKey */ }) |
                @Html.ActionLink("Информация", "Details", new { /* id=item.PrimaryKey */ }) |
                @Html.ActionLink("Удалить", "Delete", new { /* id=item.PrimaryKey */ })
            </td>
        </tr>
}
    </tbody>
</table>

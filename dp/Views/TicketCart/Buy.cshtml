@using dp.ViewModels
@model TicketPurchaseViewModel
@{
    ViewData["Title"] = "Покупка билета";
    Layout = "_Layout";
}

<h2>Купить билет</h2>

<p><strong>Мероприятие:</strong> @ViewData["EventTitle"]</p>

<form asp-action="Buy" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="EventId" />

    <div class="form-group">
        <label asp-for="Quantity"></label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>
    <input type="hidden" asp-for="RemainingTickets"/>

    <button type="submit" class="btn btn-success">Перейти к оплате</button>
</form>

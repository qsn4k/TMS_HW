@using dp.ViewModels
@model TicketCartViewModel
@{
    ViewData["Title"] = "Корзина билетов";
}

<div class="alert alert-success mt-4">
    <h2>🛒 Билеты добавлены в корзину</h2>
    <p>Вы добавили <strong>@Model.Quantity</strong> билетов на мероприятие <strong>@Model.EventTitle</strong>.</p>
</div>

<table class="table table-bordered mt-3">
    <tr>
        <th>Дата</th>
        <td>@Model.EventDateTime.ToString("dd.MM.yyyy HH:mm")</td>
    </tr>
    <tr>
        <th>Место</th>
        <td>@Model.Location</td>
    </tr>
    <tr>
        <th>Количество билетов</th>
        <td>@Model.Quantity</td>
    </tr>
    <tr>
        <th>Общая стоимость</th>
        <td>@Model.TotalPrice.ToString("C")</td>
    </tr>
    <tr>
        <th>Статус оплаты</th>
        <td>@(Model.IsPaid ? "✅ Оплачено" : "⏳ Ожидает оплаты")</td>
    </tr>
</table>

@if (!Model.IsPaid)
{
    <form asp-action="ConfirmPayment" asp-route-id="@Model.CartId" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ticketCartId" value="@Model.CartId" />
        <button type="submit" class="btn btn-success">Оплатить корзину</button>
    </form>
}
else
{
    <div class="alert alert-info mt-3">Корзина уже оплачена. Спасибо за покупку!</div>
}

<div class="mt-4">
    <a asp-action="MyTickets" class="btn btn-outline-primary">📄 Мои билеты</a>
    <a asp-controller="Event" asp-action="Index" class="btn btn-outline-secondary ms-2">🎫 Все мероприятия</a>
</div>

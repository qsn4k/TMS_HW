@model Event

<h2>@Model.Title</h2>

<p><strong>Описание:</strong> @Model.Description</p>
<p><strong>Дата:</strong> @Model.DateTime.ToString("dd.MM.yyyy HH:mm")</p>
<p><strong>Место:</strong> @Model.Location</p>
<p><strong>Цена:</strong> @Model.Price.ToString("C")</p>

<a asp-controller="Ticket" asp-action="Buy" asp-route-eventId="@Model.Id" class="btn btn-primary">Купить билет</a>

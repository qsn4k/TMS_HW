@model IEnumerable<Event>

@{
    var role = ViewContext.HttpContext.Session.GetString("Role");
}

<h2>Список мероприятий</h2>

<table class="table">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sort="@ViewBag.SortTitle">
                    Название
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sort="@ViewBag.SortDateTime">
                    Дата
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sort = "@ViewBag.SortLocation">
                    Место
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sort = "@ViewBag.SortPrice">
                    Цена
                </a>
            </th>
            <th>Всего билетов</th>
            <th>
                <a asp-action="Index" asp-route-sort ="@ViewBag.SortRemaining">
                    Доступно билетов
                </a>
            </th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ev in Model)
        {
            <tr>
                <td>@ev.Title</td>
                <td>@ev.DateTime.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@ev.Location</td>
                <td>@ev.Price.ToString("C")</td>
                <td>@ev.TotalTickets</td>
                <td>@ev.RemainingTickets</td>
                <td>
                    <a asp-action="Details" asp-route-id="@ev.Id">Подробнее</a>
                </td>
                @if (role == "Admin")
                {
                    <td>
                        <a asp-action="Edit" asp-route-id="@ev.Id">Редактировать</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@if (role == "Admin")
{
    <a asp-action="Create" class="btn btn-primary">Добавить мероприятие</a>
}

